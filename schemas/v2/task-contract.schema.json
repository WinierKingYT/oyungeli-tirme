{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WinierKingYT/oyungeli-tirme/schemas/v2/task-contract.schema.json",
  "title": "AI Game Development OS — Task Contract Schema (v2.0-draft-1)",
  "description": "Machine-readable schema for the V2.0 task-contract shape (SYS-V2-SCHEMAS-001 / TASK-SCHEMA-001). Additive to, not a replacement for, v1.2's Markdown-frontmatter task contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "system_id",
    "status",
    "rigor",
    "approval_mode",
    "authored_by",
    "approved_by",
    "ready_review_receipt",
    "base_repository",
    "base_branch",
    "base_revision",
    "scope",
    "allowed_paths",
    "allowed_commands",
    "network_policy",
    "expected_diff",
    "acceptance_criteria",
    "stop_conditions",
    "rollback",
    "lease_duration_hours",
    "invalidation_rules"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Z0-9-]+$"
    },
    "system_id": {
      "type": "string",
      "pattern": "^SYS-[A-Z0-9-]+$"
    },
    "status": {
      "type": "string",
      "description": "Canonical states per docs/08-process/SYSTEM-LIFECYCLE.md (DISCOVERY through FROZEN, plus the four disposition labels), extended with DRAFT: a task-contract-specific pre-SPECIFIED state already used in docs/templates/TASK-CONTRACT-TEMPLATE.md and docs/05-production/tasks/TASK-CARGO-001-DRAFT.md. SYSTEM-LIFECYCLE.md documents system-level states only; DRAFT is this schema's disclosed, task-instance-level extension of that vocabulary, not a silent substitution for DISCOVERY.",
      "enum": [
        "DRAFT", "DISCOVERY", "SPECIFIED", "READY_REVIEW", "READY_FOR_IMPLEMENTATION",
        "IMPLEMENTED", "VERIFIED", "INDEPENDENT_REVIEW", "ACCEPTED", "FROZEN",
        "FIX_FIRST", "BLOCKED", "CANCELED", "SUPERSEDED"
      ]
    },
    "rigor": {
      "type": "string",
      "enum": ["R0", "R1", "R2", "R3", "R4"]
    },
    "approval_mode": {
      "type": "string",
      "enum": ["hash", "ssh-signature"]
    },
    "authored_by": { "type": "string", "minLength": 1 },
    "approved_by": { "type": "string", "minLength": 1 },
    "ready_review_receipt": { "type": "string", "minLength": 1 },
    "base_repository": {
      "type": "string",
      "minLength": 1,
      "description": "Git remote/identifier this task's lease is bound to (e.g. a host/owner/repo string), per AGENTS.md's Fundamental gate and SYS-V2-SCHEMAS-001.md FR-1's 'base repository and exact revision' field."
    },
    "base_branch": {
      "type": "string",
      "minLength": 1,
      "description": "Branch this task's lease is bound to; must match AGENTS.md's Fundamental gate branch-matching requirement at lease-activation time."
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "non_scope"],
      "properties": {
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "non_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": { "enum": ["*", "**", "./**"] }
      }
    },
    "denied_paths": {
      "type": "array",
      "default": [],
      "description": "Optional, disclosed default of no explicit denials: absence means only allowed_paths' own closed list constrains writes, not an unreviewed omission.",
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_capabilities": {
      "type": "array",
      "default": [],
      "description": "Reserved for the future capability taxonomy (see SYS-V2-SCHEMAS-001 non-scope); free-form strings until that schema exists.",
      "items": { "type": "string", "minLength": 1 }
    },
    "network_policy": {
      "type": "string",
      "enum": ["none", "local-only", "remote-allowed"]
    },
    "expected_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_files", "modified_files", "removed_files",
        "dependencies_added", "schema_or_interface_change"
      ],
      "properties": {
        "new_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "modified_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "removed_files": { "type": "integer", "minimum": 0 },
        "dependencies_added": { "type": "boolean" },
        "schema_or_interface_change": { "type": "boolean" }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "criterion", "verification", "required_evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-\\d+$" },
          "category": { "type": "string", "enum": ["functional", "non-functional"] },
          "criterion": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 1 },
          "required_evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rollback": { "type": "string", "minLength": 1 },
    "lease_duration_hours": { "type": "number", "exclusiveMinimum": 0 },
    "invalidation_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
